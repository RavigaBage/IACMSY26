    "@capacitor/core": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "exceljs": "^4.4.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemailer": "^9.0.3",
    "socket.io-client": "^4.8.4"
  }
}
